{
  "name": "wb-pcf-controls",
  "private": true,
  "description": "William Buck PCF controls for Dataverse model-driven apps",
  "workspaces": [
    "packages/*",
    "controls/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:controls": "node scripts/check-controls.mjs"
  }
}

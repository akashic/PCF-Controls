{
  "name": "wb-pcf-controls",
  "private": true,
  "description": "William Buck PCF controls for Dataverse model-driven apps",
  "workspaces": [
    "packages/*",
    "controls/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:controls": "node scripts/check-controls.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "validate:config": "npm run validate:config --workspaces --if-present"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "^16.14.62",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  }
}

  "cards": [
    {
      "dot": "cyan",
      "title": "Which table's rules",
      "items": [
        "Main grid: the page's table",
        "Form subgrid: its TargetEntityType, so a subgrid of another table uses that table's file (0.2.0, #30)",
        "Each form subgrid needs its own Power Apps grid with the customizer set"
      ]
    },
    {
      "dot": "emerald",
      "title": "Per cell",
      "items": [
        "Rules sorted by priority; the first rule to set a property for a cell wins",
        "Row results cached per record and cleared at the user's local midnight",
        "Background goes on the cell container as a layer; colour, bold and pills are drawn only on plain value cells"
      ]
    },
    {
      "dot": "amber",
      "title": "Fail-soft",
      "items": [
        "No rules file: the plain grid, with one console info line",
        "Invalid rules are skipped one by one with a warning",
        "Loading over 3 s: the plain grid, and a late result is ignored",
        "A renderer error draws that cell as normal"
      ]
    }
  ]

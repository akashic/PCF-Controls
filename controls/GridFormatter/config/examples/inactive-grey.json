{
  "$schema": "../grid-format.schema.json",
  "version": 1,
  "rules": [
    {
      "id": "inactive-grey",
      "description": "Inactive records are greyed out",
      "priority": 10,
      "when": { "column": "statecode", "op": "eq", "value": 1 },
      "scope": "row",
      "style": {
        "backgroundColor": { "token": "colorNeutralForeground3" },
        "color": { "token": "colorNeutralForeground3" }
      },
      "stop": true
    }
  ]
}
